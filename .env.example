ENVIRONMENT=development
POSTGRES_DB=neuroimagen
POSTGRES_USER=neuroimagen
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+psycopg://neuroimagen:change-me-in-production@postgres:5432/neuroimagen
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
STORAGE_ROOT=/app/data/studies
ALLOWED_EXTENSIONS=.nii,.nii.gz,.dcm,.zip,.tar,.tar.gz,.gz,.json,.txt
MAX_UPLOAD_SIZE_MB=1024
PROCESSOR_NAME=dummy-development-processor
PROCESSOR_VERSION=0.1.0
PROCESSOR_COMMAND=python /app/external_processor/dummy_processor.py --input {input_dir} --output {output_dir} --study-id {study_id}
PROCESSOR_BACKEND=dummy
COMPNEURO_CONTAINER_IMAGE=compneurobilbaolab/compneuro-anatproc:1.1
COMPNEURO_ANATPROC_REF=a2f3e7c9523ed521c3f85f7dffde5ee8fb400842
COMPNEURO_PROJECT_MOUNT=/project
COMPNEURO_COMMAND=bash /app/src/apreproc_launcher.sh
WORKER_DOCKERFILE=backend/Dockerfile
PROCESSING_TIMEOUT_SECONDS=0
MAX_CONCURRENT_PROCESSING_JOBS=1
GENERATE_OUTPUT_ZIP=true
GENERATE_TECHNICAL_PDF=true
GENERATE_RENDERED_PNG=true
NIFTI_RENDERER=slicer
NIFTI_RENDER_MAX_FILES=50
NIFTI_RENDER_TIMEOUT_SECONDS=300
TECHNICAL_REPORT_FILENAME=technical_report.pdf
BIDS_VALIDATE=false
CORS_ORIGINS=http://localhost,http://localhost:5173
AUTH_SECRET_KEY=change-me-in-production
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=480
SHARE_LINK_EXPIRE_HOURS=72
RETENTION_ENABLED=false
RETENTION_DAYS=90

# Notificaciones internas y correo SMTP.
# SMTP_PASSWORD debe completarse solo en .env local; no commitear claves reales.
APP_PUBLIC_BASE_URL=http://localhost
NOTIFICATIONS_EMAIL_ENABLED=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=ae3495001@smtp-brevo.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.org
SMTP_USE_TLS=true

# Pipeline runs (opt-in). Uncomment COMPOSE_PROFILES to start pipeline-worker, beat and
# docker-proxy with `make up`; see docs/deployment.md. Leave it unset to keep the
# legacy-only stack. No secrets here.
# COMPOSE_PROFILES=pipelines
PIPELINES_DIR=/app/pipelines
STEP_MANIFESTS_DIR=/app/steps
BUNDLE_ROOT=/app/data/bundles
ORCHESTRATOR_EXECUTOR=docker
ORCHESTRATOR_STEP_EXECUTORS=
ORCHESTRATOR_POLL_SECONDS=5
ORCHESTRATOR_MAX_ATTEMPTS=2
ORCHESTRATOR_LEASE_SECONDS=600
ORCHESTRATOR_WORKER_CONCURRENCY=2
PLATFORM_VERSION=0.0.0-dev
DOCKER_PROXY_URL=http://docker-proxy:2375
# Required with the docker executor: worker_path=host_path for the data directory,
# as the Docker host sees it (absolute path of ./data on the host). Example:
# DOCKER_EXECUTOR_HOST_PATH_MAP=/app/data=/srv/stroke/data
DOCKER_EXECUTOR_HOST_PATH_MAP=
DOCKER_EXECUTOR_USER=
DOCKER_EXECUTOR_PIDS_LIMIT=512
DOCKER_EXECUTOR_PULL_MISSING=false
DOCKER_EXECUTOR_ALLOW_GPUS=false

# API side of pipeline runs. Leave unset (or commented) on instances without the
# `pipelines` profile: the API then lists no pipelines. With the profile, uncomment both
# so the API lists pipelines and validates runs (docs/deployment.md).
# API_PIPELINES_DIR=/app/pipelines
# API_STEP_MANIFESTS_DIR=/app/steps
# Deployment profile recorded on new cases: research-public, mask-only or on-premise.
DEPLOYMENT_PROFILE=research-public
