# lnm-tracts is a port of src/lnm_tracts.sh of the author's repository: the released image
# contains no code of that repository. The script is taken unmodified from the commit below only
# for the CI comparison (Dockerfile target `legacy`, never released). Read by the Dockerfile, by CI
# and by `registry.py check`, which requires the same values in the registry entry's
# source.upstream. Changing the commit is a new step version.
UPSTREAM_REPOSITORY=compneurobilbao/lnm
UPSTREAM_COMMIT=123f3298b23dafa02a67b6f096790cfe3b775fb2
# The files the wrapper takes from that commit, and the SHA-256 that pins their content
# (steps/upstream-digest.sh); the Dockerfile and steps/fetch-upstream.sh fail on a mismatch.
UPSTREAM_PATHS="src/lnm_tracts.sh"
UPSTREAM_SHA256=b58e246af5ac8012dc425c5c380cd9fa437e9f5d469bce201ea1ab7c0e0d595c
