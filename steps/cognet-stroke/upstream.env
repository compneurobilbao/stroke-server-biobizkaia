# The author's repository this wrapper consumes, unmodified, at a pinned commit. Read by the
# Dockerfile (which copies src/cdr.py of that commit into the image), by CI and by
# `registry.py check`, which requires the same values in the registry entry's source.upstream.
# Changing the commit is a new step version.
UPSTREAM_REPOSITORY=compneurobilbao/COGNET-STROKE
UPSTREAM_COMMIT=f98dbc84eae9ffaca03dc373f8a57d0b2b5e344e
