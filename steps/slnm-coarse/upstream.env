# The author's repository this wrapper consumes, unmodified, at a pinned commit. Read by the
# Dockerfile (which installs the slnm-fast package of that commit with its locked
# dependencies), by CI and by `registry.py check`, which requires the same values in the
# registry entry's source.upstream once the step has one. Changing the commit is a new step
# version. The repository is private until its first public release: the Dockerfile and
# steps/fetch-upstream.sh then need a read token (see steps/slnm-coarse/README.md).
UPSTREAM_REPOSITORY=compneurobilbao/fast-slnm
UPSTREAM_COMMIT=226f2ece4a280a6d6f566732dba4f1980b2cfb67
# The files the wrapper takes from that commit, and the SHA-256 that pins their content
# (steps/upstream-digest.sh); the Dockerfile and steps/fetch-upstream.sh fail on a mismatch.
UPSTREAM_PATHS="pyproject.toml uv.lock README.md LICENSE src"
UPSTREAM_SHA256=dc7b5869dc2b6b7cc05964d2ecde5c397309a2f4260b005852fb2c6859027061
