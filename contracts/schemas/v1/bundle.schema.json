{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/compneurobilbao/stroke-server-biobizkaia/contracts/schemas/v1/bundle.schema.json",
  "title": "Reference bundle manifest (bundle.yaml)",
  "description": "Normative text: docs/contracts/bundles.md. The content_digest formula is checked by contracts/validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "kind", "id", "version", "type", "title", "licence", "content_digest", "files"],
  "properties": {
    "contract_version": { "type": "string", "pattern": "^1\\.(0|[1-9][0-9]*)$" },
    "kind": { "const": "Bundle" },
    "id": { "$ref": "#/$defs/kebab_id" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "type": { "$ref": "#/$defs/kebab_id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "synthetic": { "type": "boolean", "default": false },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "redistributable"],
      "properties": {
        "spdx": { "type": "string", "minLength": 1, "maxLength": 200 },
        "redistributable": { "type": "boolean" },
        "terms_url": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    },
    "citation": { "type": "string", "maxLength": 2000 },
    "metadata": {
      "description": "Type-specific descriptive values that steps or the UI read (for example participant counts by sex). Scalars or arrays of scalars only.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
      "additionalProperties": {
        "oneOf": [
          { "type": ["string", "number", "integer", "boolean", "null"] },
          { "type": "array", "items": { "type": ["string", "number", "integer", "boolean"] } }
        ]
      }
    },
    "content_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))(?!bundle\\.yaml$)[A-Za-z0-9._/-]+$",
            "maxLength": 500
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "kebab_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 64
    }
  }
}
