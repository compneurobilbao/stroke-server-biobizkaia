{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/compneurobilbao/stroke-server-biobizkaia/contracts/schemas/v1/preset.schema.json",
  "title": "Preset (presets/<id>.yaml)",
  "description": "Contract 1.2: a reviewed, versioned plan request over one pipeline. Normative text: docs/contracts/presets.md. Rules P1-P8 that a schema cannot express (contract version, pipeline attachment, target resolution, feasibility, implementations, uniqueness) are checked by contracts/validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "kind", "id", "version", "title", "pipeline", "input_sets", "targets"],
  "properties": {
    "contract_version": { "$ref": "#/$defs/contract_version" },
    "kind": { "const": "Preset" },
    "id": { "$ref": "#/$defs/kebab_id" },
    "version": { "$ref": "#/$defs/semver" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 4000 },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "versions"],
      "properties": {
        "id": { "$ref": "#/$defs/kebab_id" },
        "versions": { "$ref": "#/$defs/version_range" }
      }
    },
    "input_sets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/kebab_id" }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/target" }
        },
        "if_available": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/target" }
        }
      }
    },
    "implementations": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/kebab_id" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "maxProperties": 1,
        "properties": {
          "default": { "$ref": "#/$defs/kebab_id" },
          "fixed": { "$ref": "#/$defs/kebab_id" }
        }
      }
    }
  },
  "$defs": {
    "contract_version": { "type": "string", "pattern": "^1\\.(0|[1-9][0-9]*)$" },
    "kebab_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "version_range": {
      "description": "Comma-separated comparators, all of which must hold (docs/contracts/versioning.md section 7).",
      "type": "string",
      "pattern": "^\\s*(==|>=|>|<=|<|\\^)?\\s*(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\s*(,\\s*(==|>=|>|<=|<|\\^)?\\s*(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\s*)*$"
    },
    "target": {
      "description": "A slot name (kebab-case), a produced port as <slot>.<port>, or an artefact type (snake_case).",
      "type": "string",
      "maxLength": 129,
      "pattern": "^([a-z][a-z0-9]*(-[a-z0-9]+)*(\\.[a-z][a-z0-9]*(_[a-z0-9]+)*)?|[a-z][a-z0-9]*(_[a-z0-9]+)*)$"
    }
  }
}
