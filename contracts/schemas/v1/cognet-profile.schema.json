{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/compneurobilbao/stroke-server-biobizkaia/contracts/schemas/v1/cognet-profile.schema.json",
  "title": "Cognitive disconnection profile (artefact type cognet_profile)",
  "description": "Output of the COGNET-STROKE step: for every concept of the concept-map bundle, and for every domain, a score and a permutation p-value for three measures (positive disconnection, negative disconnection, lesion overlap). Registry entry: contracts/artefact-types.yaml, type cognet_profile. Scores and p-values are null where they are undefined (for example an empty concept mask).",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "profile_version", "method", "bundle", "concepts", "domains"],
  "properties": {
    "kind": { "const": "CognetProfile" },
    "profile_version": { "type": "string", "pattern": "^1[.](0|[1-9][0-9]*)$" },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "alpha", "correction", "n_nulls", "n_parcels", "measures"],
      "properties": {
        "name": { "const": "concept-to-disconnection-representation" },
        "alpha": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "correction": { "const": "bonferroni" },
        "n_nulls": { "type": "integer", "minimum": 1 },
        "n_parcels": { "type": "integer", "minimum": 1 },
        "measures": {
          "type": "array",
          "items": { "$ref": "#/$defs/measure_name" },
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        }
      }
    },
    "bundle": {
      "description": "The concept-map bundle the scores were computed with (copied from its bundle.yaml).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "content_digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "content_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "synthetic": { "type": "boolean" }
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["concept", "domain", "disconnection_positive", "disconnection_negative", "lesion_overlap"],
        "properties": {
          "concept": { "$ref": "#/$defs/name" },
          "domain": { "$ref": "#/$defs/name" },
          "disconnection_positive": { "$ref": "#/$defs/concept_result" },
          "disconnection_negative": { "$ref": "#/$defs/concept_result" },
          "lesion_overlap": { "$ref": "#/$defs/concept_result" }
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "n_concepts", "disconnection_positive", "disconnection_negative", "lesion_overlap"],
        "properties": {
          "domain": { "$ref": "#/$defs/name" },
          "n_concepts": { "type": "integer", "minimum": 1 },
          "disconnection_positive": { "$ref": "#/$defs/domain_result" },
          "disconnection_negative": { "$ref": "#/$defs/domain_result" },
          "lesion_overlap": { "$ref": "#/$defs/domain_result" }
        }
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$", "maxLength": 64 },
    "measure_name": { "enum": ["disconnection_positive", "disconnection_negative", "lesion_overlap"] },
    "nullable_number": { "type": ["number", "null"] },
    "nullable_p": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "concept_result": {
      "description": "Score of one concept and its permutation p-value (fraction of null concept maps with a larger score, never below 1 / n_nulls); p_corrected is Bonferroni over all concepts for the same measure.",
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "p_value", "p_corrected", "significant"],
      "properties": {
        "score": { "$ref": "#/$defs/nullable_number" },
        "p_value": { "$ref": "#/$defs/nullable_p" },
        "p_corrected": { "$ref": "#/$defs/nullable_p" },
        "significant": { "type": "boolean" },
        "flag": {
          "description": "Present when the score is a degenerate case: empty_mask (no parcel inside or outside the concept) or zero_outside_mean (the mean outside the concept is zero, so the score is the inside mean, not a ratio).",
          "enum": ["empty_mask", "zero_outside_mean"]
        }
      }
    },
    "domain_result": {
      "description": "Score of a domain (mean of the finite scores of its concepts) and its p-value (smallest concept p-value of the domain times the number of its concepts, at most 1); p_corrected is Bonferroni over all domains.",
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "p_value", "p_corrected", "significant"],
      "properties": {
        "score": { "$ref": "#/$defs/nullable_number" },
        "p_value": { "$ref": "#/$defs/nullable_p" },
        "p_corrected": { "$ref": "#/$defs/nullable_p" },
        "significant": { "type": "boolean" }
      }
    }
  }
}
